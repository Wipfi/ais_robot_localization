<launch>
    <node name="localization_monitor_py" pkg="ais_robot_localization" type="localization_monitor_node.py" output="screen">
        <param name="dist_cum_threshold" value="15.0" />
        <param name="publish_rate" value="0.5" /> 
        <param name="max_poses_threshold" value="500"/>
        <remap from="/global_odom" to="/odom_gnss"/>
        <remap from="/local_odom" to="/localization/odometry/odom_lidar"/>

        <remap from="/global_odom_path" to="/localization/monitor_py/global_reference_path"/>
        <remap from="/local_odom_path" to="/localization/monitor_py/local_reference_path"/>
        <remap from="/localization_result" to="/localization/monitor_py/result"/>
        <remap from="/RPE_Values" to="/localization/monitor_py/RPE_Values"/>
    </node>
</launch>
